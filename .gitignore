# Dependency directories
node_modules/
npm-debug.log*
yarn-error.log*

# Build directories
/build/
/dist/
/.next/
/out/
/.nuxt/
/.expo/
/.parcel-cache/
/.cache/

# Environment files
.env.local
.env.development.local
.env.test.local
.env.production.local

# Log files
logs/
*.log

# Editor directories and files
# Ignore .vscode contents but keep settings.json: it carries the ESLint
# working-directory config both apps need. Note this must be `.vscode/*`, not
# `.vscode/` — git cannot re-include a file whose parent directory is excluded.
.vscode/*
!.vscode/settings.json
.idea/
*.iml

# macOS
.DS_Store

# Temporary files
*.tmp
*.temp

# Compiled files
*.compiled.js
*.map

# Other generated files
*.zip
*.rar
*.tar.gz
*.tgz
*.bak
*.swp
Thumbs.db
